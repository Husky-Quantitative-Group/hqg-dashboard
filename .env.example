# Copy to .env and fill in. docker compose substitutes these into docker-compose.yml,
# and the api container receives all of them.

# --- Database --------------------------------------------------------------------
# docker-compose.yml builds the api's DATABASE_URL from these. Outside Docker, set
# DATABASE_URL=postgresql://user:password@host:5432/dbname instead.
POSTGRES_DB=hqg_dashboard
POSTGRES_USER=hqg
# It is part of a URL, so use letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- URLs ------------------------------------------------------------------------
# The dashboard frontend: the only allowed CORS origin, and where sign-ins return to.
FRONTEND_BASE_URL=https://dashboard.uconnquant.com
# This API as browsers reach it (the frontend's CORE_API_URL). Signed backtest
# upload and download URLs are built from it.
PUBLIC_API_URL=https://api.uconnquant.com
# Defaults to $PUBLIC_API_URL/auth/callback; CAS must accept it as a service URL.
# CAS_CALLBACK_URL=
# CAS_BASE_URL=https://login.uconn.edu/cas

# --- Sessions --------------------------------------------------------------------
# prod: Secure, SameSite=Strict cookies for AUTH_COOKIE_DOMAIN (default .uconnquant.com).
# Anything else (e.g. dev): SameSite=Lax cookies for the API's host only.
APP_ENV=prod
# AUTH_COOKIE_DOMAIN=.uconnquant.com
# AUTH_COOKIE_MAX_AGE_SECONDS=86400

# --- Engine accounts -------------------------------------------------------------
# Execution is denied unless both readiness checks pass. These were the Terraform
# variables engine_control_readiness_url, engine_control_readiness_token and
# engine_frontend_readiness_url.
CONTROL_READINESS_URL=
CONTROL_READINESS_TOKEN=
WEBSITE_READINESS_URL=

# --- Limits and tuning -----------------------------------------------------------
# BACKTEST_UPLOAD_MAX_BYTES=26214400
# BACKTEST_PAYLOAD_MAX_BYTES=268435456
# DATABASE_POOL_SIZE=10
# WEB_CONCURRENCY=2
# API_PORT=5000

# --- Outbound proxy, if the host needs one (image builds and CAS validation) ------
# Readiness probes never use it. NO_PROXY should name local services the API calls,
# e.g. localhost,127.0.0.1,hqg-backtester for `seed --backtester-url`.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
no_proxy=

# --- Local development -----------------------------------------------------------
# Trust the local HTTPS proxy in dev/local-https (see docs/local_setup.md).
# COMPOSE_FILE=docker-compose.yml:dev/local-https/api.compose.yaml
